# =============================================================================
# NotaryTON / MemeSeal - environment for docker-compose.prod.yml
# =============================================================================
# Copy to .env (git-ignored) and fill in. Names only: never commit a value.
# Generate secrets with `openssl rand -hex 32`. Hex matters for two of them:
# POSTGRES_PASSWORD is embedded raw in DATABASE_URL, and Telegram accepts only
# A-Z a-z 0-9 _ - in TELEGRAM_WEBHOOK_SECRET.
#
# Optional names are commented out on purpose: an empty value is not the same as
# unset (it replaces the code's default), so uncomment only what you set.
# =============================================================================

# ---- Required by docker-compose.prod.yml -------------------------------------
# Public https origin Caddy serves for this app. No trailing slash, no path.
# Telegram webhooks are registered here and seal replies link to it.
WEBHOOK_URL=https://<NOTARY_HOST>
# Bundled Postgres. Only applied when the db volume is first created.
POSTGRES_PASSWORD=

# ---- Required by the bot -----------------------------------------------------
# @BotFather token (<digits>:<secret>).
BOT_TOKEN=
# Sent to Telegram with setWebhook and checked on every update.
# Unset: webhooks are not registered and every update is rejected.
TELEGRAM_WEBHOOK_SECRET=
# 24-word mnemonic of the service wallet (WalletV5R1, deployed and funded).
TON_WALLET_SECRET=
# UQ/EQ address of that wallet. Unset: no seals and no payment poller.
# The poller is how TON payments are detected.
SERVICE_TON_WALLET=

# ---- Optional: admin ---------------------------------------------------------
# Sent as the X-Admin-Secret header to /admin/* and POST /api/v1/kols/seed.
# Unset: those endpoints are disabled.
# ADMIN_SECRET=

# ---- Optional: more bots -----------------------------------------------------
# MemeSeal bot (also posts to TELEGRAM_CHANNEL_ID) and MemeScan bot.
# MEMESEAL_BOT_TOKEN=
# MEMESCAN_BOT_TOKEN=
# Announcement channel, default @MemeSealTON.
# TELEGRAM_CHANNEL_ID=
# Comma-separated chat ids; the bot posts to each on every startup.
# GROUP_IDS=

# ---- Optional: TON / TonConsole ----------------------------------------------
# TonAPI key for MemeScan and the crawler (unauthenticated and rate-limited without).
# TONAPI_KEY=
# POST /webhook/tonapi accepts only bodies signed as X-TonAPI-Signature =
# hex HMAC-SHA256(body, this secret). TonAPI does not document signing its
# webhook deliveries, so treat that endpoint as disabled: payments come from the
# poller above. Unset: the endpoint rejects every request.
# TONAPI_WEBHOOK_SECRET=
# Sign POST /webhook/casino and /webhook/tokens. Unset: those webhooks reject everything.
# TONCONSOLE_CASINO_SECRET=
# TONCONSOLE_TOKENS_SECRET=
# Contract addresses; defaults are hardcoded in bot.py.
# SEAL_CASINO_ADDRESS=
# SEAL_TOKENS_ADDRESS=
# TON ID login (TONID_REDIRECT_URI defaults to https://notaryton.com/auth/tonid/callback).
# TONID_CLIENT_ID=
# TONID_REDIRECT_URI=

# ---- Optional: features ------------------------------------------------------
# 'true' to enable.
# CRAWLER_ENABLED=
# MEMESCAN_TWITTER_ENABLED=

# ---- Optional: money switches (all off; only the exact value 'true' enables) --
# These move value at a user's request, hold user balances, or run a lottery.
# Leave them unset until a written Canadian legal opinion says otherwise.
# /api/v1/casino/* routes. Unset: every one answers 503 "casino disabled".
# CASINO_ENABLED=
# Seconds a Mini App's signed Telegram initData stays valid for the casino API (default 86400).
# CASINO_INIT_DATA_MAX_AGE=
# Right after deploying: call POST /admin/void-legacy-lottery once
# (X-Admin-Secret header); no Sunday draw runs until it has. It also takes back
# casino chips minted by forged wins. Then audit users.referral_earnings and the
# remaining casino_balances.chips before setting any switch below. Nothing voids
# legacy lottery entries automatically. See docs/ENV-VARS.md, which also has the
# TON payment cutover steps and the ton_payments_processed review queue.
# The weekly lottery (paid entries, a draw, a prize: a lottery under Criminal Code s.206).
# Unset: no entries, no Sunday draw, /pot and /api/v1/lottery/* answer 503, no tickets or pot shown.
# LOTTERY_ENABLED=
# Sunday draw sends the pot in TON to the winner's saved wallet. Unset: the prize is held in lottery_prizes.
# LOTTERY_AUTO_PAYOUT_ENABLED=
# /withdraw sends referral earnings in TON (never lottery prizes). Unset: "withdrawals paused".
# /api/v1/casino/withdraw: 503 while off, 501 when on (no cash-out exists).
# WITHDRAWALS_ENABLED=
# Seals one API key may order per hour, per worker process (default 30). Also the largest batch.
# API_SEALS_PER_HOUR=

# ---- Optional: X / Twitter ---------------------------------------------------
# Seal auto-posting. Unset: X posting is skipped.
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# MemeScan auto-poster account; each falls back to the TWITTER_* value above.
# MEMESCAN_TWITTER_API_KEY=
# MEMESCAN_TWITTER_API_SECRET=
# MEMESCAN_TWITTER_ACCESS_TOKEN=
# MEMESCAN_TWITTER_ACCESS_SECRET=

# ---- Optional: compose -------------------------------------------------------
# Bundled Postgres role and database, default notaryton/notaryton.
# POSTGRES_USER=
# POSTGRES_DB=
# 'disable' (default) for the bundled Postgres; 'require' only for a managed one.
# DATABASE_SSL=
# Loopback port the bot is published on, default 8000 (unused under onebox).
# BOT_PORT=
#
# DATABASE_URL and PORT are set by docker-compose.prod.yml and override .env.
